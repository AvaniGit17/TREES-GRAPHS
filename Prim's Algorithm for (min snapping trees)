#include <iostream>
#include <vector>
#include<functionality>
#include <queue>

using namespace std;

int primeMST(int V, vector<vector<pair<int, int>>> adj) {
    vector<bool> inMST(V, false);

    // min heap
    priority_queue<pair<int, int>,
    vector<pair<int, int>>,
    greater<pair<int, int>>> pq;
      int mstcost = 0;
    pq.push({0, 0});

    while (pq.size() > 0) {
        auto p = pq.top();
        int wt = p.first;
        int u = p.second;
        pq.pop();

        if ( !inMST[u]) {
            inMST[u] = true;
            mstcost+= wt;

            for (int i = 0; i < adj[u].size(); i++) {
                int v = adj[u][i].first;
                int w = adj[u][i].second;

                if (! inMST[v]) {
                    pq.push({w, v});
                }
            }
        }
    }

    return mstcost;
}

int main() {
    int V = 4;

    vector<vector<pair<int, int>>> adj(V);

    // Edge 0 - 1, weight 10
    adj[0].push_back({1, 10});
    adj[1].push_back({0, 10});

    // Edge 0 - 2, weight 15
    adj[0].push_back({2, 15});
    adj[2].push_back({0, 15});

    // Edge 1 - 2, weight 5
    adj[1].push_back({2, 5});
    adj[2].push_back({1, 5});

    // Edge 1 - 3, weight 12
    adj[1].push_back({3, 12});
    adj[3].push_back({1, 12});

    // Edge 2 - 3, weight 8
    adj[2].push_back({3, 8});
    adj[3].push_back({2, 8});

    cout << "Minimum cost of MST: " << primeMST(V, adj);

    return 0;
}
